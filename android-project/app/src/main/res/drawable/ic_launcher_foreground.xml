<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Ambient Radial Glow -->
    <path
        android:pathData="M54,54m-28,0a28,28 0 1,0 56,0a28,28 0 1,0 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="28"
                android:type="radial">
                <item android:color="#40FF6B00" android:offset="0.0" />
                <item android:color="#1AEC4899" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tilted Quantum Orbital Ellipse (Back arc) -->
    <path
        android:pathData="M24,68 C22,60 36,44 54,40 C72,36 86,42 88,50 C90,58 76,74 58,78 C40,82 26,76 24,68 Z"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="68"
                android:endX="88"
                android:endY="50"
                android:type="linear">
                <item android:color="#FFFF8C42" android:offset="0.0" />
                <item android:color="#FFFFE082" android:offset="0.5" />
                <item android:color="#FFFF5722" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sovereign Core Sphere -->
    <path
        android:pathData="M54,54m-16,0a16,16 0 1,0 32,0a16,16 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="42"
                android:endX="66"
                android:endY="66"
                android:type="linear">
                <item android:color="#FFFF8C42" android:offset="0.0" />
                <item android:color="#FFFF5500" android:offset="0.6" />
                <item android:color="#FFD84315" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Radiant Center -->
    <path
        android:pathData="M54,54m-9,0a9,9 0 1,0 18,0a9,9 0 1,0 -18,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="9"
                android:type="radial">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFFFD54F" android:offset="0.6" />
                <item android:color="#FFFF8C42" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orbital Node / Satellite Particle -->
    <path
        android:pathData="M78,46m-3.5,0a3.5,3.5 0 1,0 7,0a3.5,3.5 0 1,0 -7,0"
        android:fillColor="#FFFFFFFF" />
</vector>