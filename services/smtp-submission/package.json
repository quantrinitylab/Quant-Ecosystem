{
  "name": "@quant/smtp-submission",
  "version": "1.0.0",
  "private": true,
  "description": "RFC 6409 Authenticated SMTP Submission Daemon on Port 587 with STARTTLS and SASL",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@quant/auth": "workspace:*",
    "@quant/database": "workspace:*",
    "@quant/queue": "workspace:*",
