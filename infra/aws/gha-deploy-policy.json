{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPushPull",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:266176113726:repository/quant-admin",
        "arn:aws:ecr:us-east-1:266176113726:repository/quant-quantmail",
        "arn:aws:ecr:us-east-1:266176113726:repository/quant-quantchat",
        "arn:aws:ecr:us-east-1:266176113726:repository/quant-quantai",
        "arn:aws:ecr:us-east-1:266176113726:repository/quant-ws-gateway"
      ]
    },
    {
      "Sid": "EksDescribe",
      "Effect": "Allow",
      "Action": ["eks:DescribeCluster"],
      "Resource": "arn:aws:eks:us-east-1:266176113726:cluster/quant-production-eks"
    }
  ]
}
