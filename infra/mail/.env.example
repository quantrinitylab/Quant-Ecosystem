# Stalwart lab environment (placeholders only).
# Copy to stalwart/.env on the VM (mode 600). Never commit the real file.
# Values marked SECRET are read by Stalwart itself from the container
# environment (SecretKey "EnvironmentVariable" variant); they are never
# written into the rendered plan.

# ---- identity ---------------------------------------------------------------
LAB_DOMAIN=lab.quantrinity.in
MAIL_HOSTNAME=mail.lab.quantrinity.in
# Cloudflare zone that contains LAB_DOMAIN (the parent zone, not the lab name)
DNS_ZONE=quantrinity.in

# ---- TLS (ACME) -------------------------------------------------------------
# Dns01 (default, needs CLOUDFLARE_DNS_TOKEN) or Http01 (needs port 80 open)
ACME_CHALLENGE=Dns01
ACME_CONTACT=postmaster@example.invalid
# Use the staging directory while debugging to protect the production rate limit:
# https://acme-staging-v02.api.letsencrypt.org/directory
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# SECRET. Cloudflare API token limited to Zone > DNS > Edit on DNS_ZONE.
CLOUDFLARE_DNS_TOKEN=

# ---- blob storage -----------------------------------------------------------
# r2 = Cloudflare R2 (S3 API); local = blobs stay in the embedded DB on the data volume
STORAGE_BLOBS=local
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=quantmail-mailblobs
# SECRET
R2_ACCESS_KEY_ID=
# SECRET
R2_SECRET_ACCESS_KEY=

# ---- outbound routing -------------------------------------------------------
# relay = all non-local recipients go to the smart host below (lab default)
# mx    = direct delivery (the one-line change; needs outbound port 25)
OUTBOUND_ROUTE=relay
RELAY_HOST=smtp.example.invalid
RELAY_PORT=587
RELAY_USER=
# SECRET
RELAY_PASS=

# ---- test accounts (internal directory) ------------------------------------
# Leave empty and provision.sh generates random ones into stalwart/.rendered/accounts.env
LAB_ALICE_PASSWORD=
LAB_BOB_PASSWORD=

# ---- lab-only relaxations ---------------------------------------------------
# 1 raises the default inbound throttles so the 2,000 message load test can run; 0 keeps Stalwart defaults
LAB_RELAX_THROTTLES=1

# ---- hooks ------------------------------------------------------------------
# The "hooks" compose service receives both. Change to a real endpoint when needed.
WEBHOOK_URL=http://hooks:9000/webhook
MTA_HOOK_URL=http://hooks:9000/mta-hook

# ---- directory ----------------------------------------------------------------
# internal = accounts alice and bob live in Stalwart (plan 40)
# sql      = accounts come from the Postgres users table (plan 45, compose profile "sqldir")
DIRECTORY=internal

# ---- alternative SQL directory (compose profile "sqldir") --------------------
# SECRET (container admin of the throw-away Postgres; the lab SQL fixture creates the read-only role)
PG_ADMIN_PASSWORD=
PG_HOST=postgres
PG_PORT=5432
PG_DB=quantusers
PG_USER=stalwart_ro
# SECRET
PG_PASSWORD=

# ---- local test client settings (lab/tests) ---------------------------------
# Used by the scripts in infra/mail/lab/tests when run from a laptop or the VM.
TEST_HOST=mail.lab.quantrinity.in
TEST_ALICE=alice@lab.quantrinity.in
TEST_BOB=bob@lab.quantrinity.in
TEST_ALICE_PASSWORD=
TEST_BOB_PASSWORD=
