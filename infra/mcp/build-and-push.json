{
  "commands": [
    "set -eu",
    "echo DISK=$(df -h / | tail -1 | awk '{print $4}')",
    "cd /opt/actions-runner/_work",
    "rm -rf deploy-quantmail 2>/dev/null || true",
    "git clone --depth 1 https://github.com/quantrinitylabsgo/Quant-Ecosystem.git deploy-quantmail 2>&1 | tail -2",
    "cd deploy-quantmail",
    "RELEASE_SHA=$(git rev-parse HEAD)",
    "echo SHA=$RELEASE_SHA",
    "REGISTRY=266176113726.dkr.ecr.us-east-1.amazonaws.com",
    "REPO=quant-quantmail",
    "aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin $REGISTRY 2>&1 | tail -2",
    "echo BUILDING...",
    "docker build -f apps/quantmail/Dockerfile -t $REGISTRY/$REPO:$RELEASE_SHA . 2>&1 | tail -15",
    "echo BUILD_EXIT=$?",
    "docker images $REGISTRY/$REPO --format '{{.Tag}} {{.Size}}'",
    "echo PUSHING...",
    "docker push $REGISTRY/$REPO:$RELEASE_SHA 2>&1 | tail -8",
    "echo PUSH_EXIT=$?",
    "DIGEST=$(aws ecr describe-images --repository-name $REPO --image-ids imageTag=$RELEASE_SHA --region us-east-1 --query 'imageDetails[0].imageDigest' --output text 2>&1)",
    "echo DIGEST=$DIGEST",
    "echo QUANTMAIL_IMAGE_LIVE"
  ]
}
