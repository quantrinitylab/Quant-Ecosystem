{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@quant/common": ["../../packages/common/src/index.ts"],
      "@quant/common/*": ["../../packages/common/src/*"],
      "@quant/auth": ["../../packages/auth/src/index.ts"],
      "@quant/auth/*": ["../../packages/auth/src/*"],
      "@quant/database": ["../../packages/database/dist/index.d.ts"],
      "@quant/database/*": ["../../packages/database/dist/*"],
      "@quant/realtime": ["../../packages/realtime/src/index.ts"],
      "@quant/realtime/*": ["../../packages/realtime/src/*"],
      "@quant/server-core": ["../../packages/server-core/src/index.ts"],
      "@quant/server-core/*": ["../../packages/server-core/src/*"],
      "@quant/storage": ["../../packages/storage/src/index.ts"],
      "@quant/storage/*": ["../../packages/storage/src/*"],
      "@quant/ai": ["../../packages/ai/src/index.ts"],
      "@quant/ai/*": ["../../packages/ai/src/*"],
      "@quant/quant-tools": ["../../packages/quant-tools/src/index.ts"],
      "@quant/quant-tools/*": ["../../packages/quant-tools/src/*"],
      "@quant/quanty-contracts": ["../../packages/quanty-contracts/src/index.ts"],
      "@quant/quanty-contracts/*": ["../../packages/quanty-contracts/src/*"]
    }
  },
  "include": ["backend/**/*.ts"],
  "exclude": ["node_modules"]
}
