{
  "name": "@quant/quantchat",
  "version": "1.0.0",
  "private": true,
  "description": "QuantChat - Snapchat-like messaging app with stories, snaps, calls, AR filters, and AI integration",
  "main": "backend/app.ts",
  "scripts": {
    "dev": "next dev",
    "dev:backend": "node --loader ts-node/esm backend/app.ts",
    "build": "next build",
    "build:backend": "tsc --noEmit -p tsconfig.backend.json",
    "start": "next start",
    "start:backend": "tsx backend/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.backend.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@quant/api-client": "workspace:*",
    "@quant/auth": "workspace:*",
    "@quant/ai": "workspace:*",
    "@quant/common": "workspace:*",
    "@quant/cross-app-gaming": "workspace:*",
    "@quant/database": "workspace:*",
    "@quant/queue": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@quant/ar-lenses": "workspace:*",
    "@quant/encryption": "workspace:*",
    "@quant/federation": "workspace:*",
    "@quant/notifications": "workspace:*",
    "@quant/realtime": "workspace:*",
    "@quant/server-core": "workspace:*",
    "@quant/brand": "workspace:*",
    "@quant/shared-ui": "workspace:*",
    "@quant/storage": "workspace:*",
    "fastify": "^5.12.8",
    "@fastify/websocket": "^11.3.7",
    "argon2": "^0.45.2",
    "livekit-server-sdk": "^2.19.2",
    "livekit-client": "^2.23.0",
    "ioredis": "^5.11.1",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@tanstack/react-query": "^5.106.1",
    "framer-motion": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.13",
    "vitest": "^4"
  }
}
