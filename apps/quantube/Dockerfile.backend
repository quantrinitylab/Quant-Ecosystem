# syntax=docker/dockerfile:1
# ============================================================================
# @quant/quantube — BACKEND (Fastify API) image.
# The frontend image runs `next start`; this image runs the bundled Fastify
# backend (backend/server.ts). The monorepo uses moduleResolution=bundler, so
# the backend is bundled into one self-contained ESM file via esbuild
# (infra/scripts/build-backend.mjs); only native/generated packages
# (@prisma/client + query engine, argon2, sharp) stay external and are provided
# by the copied node_modules.
# ============================================================================
FROM node:22-slim AS deps
# openssl is required: Prisma's query engine detects the libssl version at
# runtime and node:22-slim ships none. Installed here (the builder derives from
# this stage and `prisma generate` picks the engine here) and again in runner
# (where the engine actually runs).
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json turbo.json ./
COPY patches/ ./patches/
COPY packages/ ./packages/
COPY apps/quantube/ ./apps/quantube/
COPY infra/scripts/ ./infra/scripts/
RUN pnpm install --frozen-lockfile --ignore-scripts --network-concurrency 1 --child-concurrency 1

FROM deps AS builder
ENV NODE_OPTIONS="--max-old-space-size=2048"
RUN npx prisma@6.19.3 generate --schema=packages/database/prisma/schema.prisma
RUN node infra/scripts/build-backend.mjs apps/quantube backend/server.ts apps/quantube/backend/dist/server.mjs

FROM node:22-slim AS runner
# openssl: see the deps-stage note (Prisma query engine libssl detection).
# ffmpeg: the media engine (VideoTranscoder) shells out to ffmpeg. The
# @ffmpeg-installer/ffmpeg npm shim can't provide the binary in the bundled
# image (its optional platform package isn't materialised by pnpm), so we
# install the system binary and point the code at it via FFMPEG_PATH.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ffmpeg \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 quantapp
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3006
ENV HOST=0.0.0.0
ENV HOME=/tmp
ENV FFMPEG_PATH=/usr/bin/ffmpeg

COPY --from=builder --chown=quantapp:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=quantapp:nodejs /app/packages/ ./packages/
COPY --from=builder --chown=quantapp:nodejs /app/apps/quantube/ ./apps/quantube/
COPY --from=builder --chown=quantapp:nodejs /app/package.json ./package.json
COPY --from=builder --chown=quantapp:nodejs /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

USER quantapp
EXPOSE 3006

# /livez (process-alive), not /readyz (which 503s on a transient DB blip) and
# not /health (not a route). Kubernetes ignores this HEALTHCHECK but it keeps
# plain docker/compose honest.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3006/livez').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))" || exit 1

CMD ["node", "apps/quantube/backend/dist/server.mjs"]
