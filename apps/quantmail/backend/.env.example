# QuantMail backend: outbound mail transport (placeholders only, never commit real values)
#
# MAIL_TRANSPORT selects how external mail leaves the backend:
#   ses   AWS SES v2 (default; behaviour unchanged when this is unset)
#   smtp  SMTP submission relay (for example OCI Email Delivery)
MAIL_TRANSPORT=ses

# --- SES (MAIL_TRANSPORT=ses) ---
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_REGION=us-east-1
# SES_CONFIGURATION_SET=quantmail-sending

# --- SMTP relay (MAIL_TRANSPORT=smtp) ---
# STARTTLS is required: the send fails instead of falling back to plaintext.
# The relay is expected to sign DKIM itself; keep SMTP_DKIM_SIGN off then.
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_USER=replace-with-relay-username
# SMTP_PASS=replace-with-relay-password
# SMTP_REQUIRE_TLS=true
# From address used when a caller supplies none; it must be an approved sender at the relay.
# SMTP_FROM_DEFAULT=QuantMail <no-reply@quantmail.in>
# Sign DKIM in the worker before relaying (only for a relay that does not sign). Default false.
# SMTP_DKIM_SIGN=false
# Max pooled connections to the relay. Default 3.
# SMTP_POOL_MAX_CONNECTIONS=3

# --- From addresses the backend uses (all must be approved senders at the relay) ---
# VERIFICATION_EMAIL_FROM=QuantMail <no-reply@quantmail.in>
# PASSWORD_RESET_FROM=QuantMail <no-reply@quantmail.in>
# WORKSPACE_INVITE_FROM=QuantMail <no-reply@quantmail.in>
# CALENDAR_RSVP_NOTIFY_FROM=QuantMail Calendar <no-reply@quantmail.in>
# CALENDAR_BOOKING_NOTIFY_FROM=QuantMail Calendar <no-reply@quantmail.in>
