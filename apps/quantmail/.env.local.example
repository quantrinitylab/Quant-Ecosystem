# QuantMail Environment Variables
QUANTMAIL_BACKEND_URL=http://localhost:3010

# Regular product APIs use the same-origin Next.js /api proxy layer.
NEXT_PUBLIC_API_URL=/api

# Browser auth defaults to the same-origin /api/auth proxy routes: call sites
# use '/auth/<action>' paths and the default base '/api' resolves them to the
# proxy (edge middleware never intercepts /api/*). The HttpOnly refresh cookie
# uses Path=/ so the browser sends it to those proxy routes and the edge
# middleware can read it as the signed-in signal on page routes. Set this only
# for a deliberately reviewed direct auth origin.
NEXT_PUBLIC_AUTH_URL=
