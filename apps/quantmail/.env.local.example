# QuantMail Environment Variables
QUANTMAIL_BACKEND_URL=http://localhost:3010

# Regular product APIs use the same-origin Next.js /api proxy layer.
NEXT_PUBLIC_API_URL=/api

# Browser auth defaults to the same-origin /auth proxy so the hardened
# HttpOnly cookie's narrow Path=/auth reaches refresh and logout requests.
# Set this only for a deliberately reviewed direct auth origin.
NEXT_PUBLIC_AUTH_URL=
