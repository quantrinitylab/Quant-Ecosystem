PORT=3003
JWT_SECRET=dev-secret-change-in-production
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://quant:quant@localhost:5432/quantdb

# Production inference provider. Leave AI_PROVIDER empty for local mock/provider selection.
AI_PROVIDER=
AI_DEFAULT_MODEL=@cf/meta/llama-3.2-1b-instruct
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-1b-instruct
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts
QUANT_AI_FAIL_CLOSED=true

# Memory V2 canary (keep legacy until ADR-011 gates are approved)
QUANTAI_MEMORY_MODE=legacy
QDRANT_URL=http://localhost:6333
OPENAI_API_KEY=
# Required when QUANTAI_MEMORY_MODE=shadow
QUANT_COMMIT_SHA=replace-with-full-40-character-git-sha
MEMORY_POLICY_VERSION=memory-policy-v1
MEMORY_CORPUS_VERSION=real-conv-v1
MEMORY_SHADOW_RETENTION_DAYS=30
