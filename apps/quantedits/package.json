{
  "name": "@quant/quantedits",
  "version": "1.0.0",
  "private": true,
  "description": "QuantEdits - Professional video/photo editor with AI-powered tools and real-time collaboration",
  "main": "backend/app.ts",
  "scripts": {
    "dev": "next dev",
    "dev:backend": "node --loader ts-node/esm backend/app.ts",
    "build": "next build",
    "build:backend": "tsc --noEmit -p tsconfig.backend.json",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.backend.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@quant/api-client": "workspace:*",
    "@quant/auth": "workspace:*",
    "@quant/ai": "workspace:*",
    "@quant/brand": "workspace:*",
    "@quant/common": "workspace:*",
    "@quant/database": "workspace:*",
    "@quant/media": "workspace:*",
    "@quant/realtime": "workspace:*",
    "@quant/server-core": "workspace:*",
    "@quant/shared-ui": "workspace:*",
    "fastify": "^5.12.0",
    "framer-motion": "^11.0.0",
    "ioredis": "^5.11.1",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-query": "^5.101.4",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.13",
    "vitest": "^3"
  }
}
