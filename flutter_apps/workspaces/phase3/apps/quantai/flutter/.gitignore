# Dart/Flutter build outputs
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.log
.packages
.pub-cache/
.pub/

# Library packages must not commit their lock files.
packages/**/pubspec.lock

# Generated API client code — produced by CI from the QuantAI OpenAPI spec,
# never committed.
packages/**/lib/src/codegen/generated/

# Platform runner generated artifacts
ios/Pods/
ios/.symlinks/
