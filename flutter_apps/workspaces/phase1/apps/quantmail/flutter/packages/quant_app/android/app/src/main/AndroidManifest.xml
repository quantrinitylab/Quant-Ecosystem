<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal QuantMail runner manifest.
     Launch-theme / launcher-icon resources come from `flutter create .`
     (run once on a machine with the Flutter SDK if regenerating from scratch). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- S5 (security audit): android:allowBackup="false" — the offline mail
         cache and tokens must never enter Google auto-backup. -->
    <application
        android:allowBackup="false"
        android:label="QuantMail"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Splash / normal theme metadata consumed by the embedding. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth2/PKCE redirect: quantmail://oauth/callback (custom
                 scheme — no android:autoVerify, this is not an https App Link). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="quantmail" android:host="oauth" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- The OAuth2/PKCE login flow opens the system browser via Custom Tabs. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
