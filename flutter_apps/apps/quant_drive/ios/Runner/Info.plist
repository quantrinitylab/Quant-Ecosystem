<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>QuantDrive</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.quant.drive</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>QuantDrive</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Sovereign Multiplatform Hardware Permissions -->
	<key>NSCameraUsageDescription</key>
	<string>QuantDrive requires camera access for instant document capture and QR key exchange.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>QuantDrive requires Face ID / Touch ID to unlock the AES-256 E2EE Cryptographic Vault.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>QuantDrive requires photo library access to ingest and deduplicate media assets via FastCDC.</string>

	<!-- High-Performance Impeller Acceleration -->
	<key>FLTEnableImpeller</key>
	<true/>
	<key>io.flutter.embedded_views_preview</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Sovereign Deep Linking URL Schemes -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.quant.drive</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>quantdrive</string>
				<string>quant-vault</string>
				<string>quant-cas</string>
			</array>
		</dict>
	</array>

	<!-- Sibling Quant Ecosystem App Discovery Schemes -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>quantmail</string>
		<string>quantchat</string>
		<string>quantgram</string>
		<string>quantube</string>
		<string>quanttube</string>
		<string>quantai</string>
		<string>quantwave</string>
		<string>quantcalendar</string>
		<string>quantads</string>
		<string>quantcooks</string>
	</array>
</dict>
</plist>

