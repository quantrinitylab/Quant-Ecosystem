{
  "name": "quant-ecosystem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quant Ecosystem - A 9-app interconnected platform",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "build": "turbo build",
    "build:ci": "turbo build --concurrency=3",
    "build:cold": "rm -rf .turbo node_modules/.cache && turbo build --concurrency=3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm test && pnpm build && pnpm lint",
    "validate:fast": "turbo typecheck test lint --filter=...[HEAD~1]",
    "prepare": "husky",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:core": "turbo dev --filter=@quant/quantmail --filter=@quant/quantchat --filter=@quant/quantai",
    "dev:apps": "turbo dev",
    "dev:all": "pnpm dev:infra && turbo dev",
    "doctor": "tsx scripts/doctor.ts",
    "env:check": "tsx scripts/env-check.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @quant/database exec prisma migrate deploy",
    "db:seed": "pnpm --filter @quant/database exec prisma db seed",
    "db:reset": "tsx scripts/db-reset.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --shard=$CI_SHARD",
    "test:a11y": "playwright test --project=chromium e2e/tests/a11y/",
    "lint:strict": "turbo lint -- --max-warnings 0",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "wiring:dod": "tsx scripts/evaluate-wiring-dod.ts",
    "guard:inline-fetch": "tsx scripts/check-inline-fetch.ts",
    "memory:validate": "tsx scripts/validate-project-memory.ts",
    "test:memory": "vitest run scripts/__tests__/validate-project-memory.test.ts",
    "m11d:wu4": "tsx scripts/m11d-wu4-quantai-shadow.ts",
    "m11d:wu5:release-gate": "tsx scripts/m11d-wu5-release-gate.ts",
    "test:wu5:policy": "vitest run scripts/__tests__/m11d-wu5-release-gate.test.ts",
    "dependency:heatmap": "node scripts/dependency-heatmap.mjs --json",
    "test:dependency-heatmap": "vitest run scripts/__tests__/dependency-heatmap.test.ts",
    "audit:dependencies": "node scripts/dependency-audit.mjs --level high",
    "test:dependency-audit": "vitest run scripts/__tests__/dependency-audit.test.ts",
    "ci:gates": "turbo typecheck && turbo lint -- --max-warnings 0 && turbo test && turbo build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "esbuild": ">=0.28.1",
      "vite": "^6.4.3",
      "postcss@<=8.5.22": "8.5.23",
      "uuid": ">=11.1.1",
      "form-data": "^4.0.6",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "brace-expansion": "5.0.12",
      "adm-zip@<0.6.1": "0.6.1",
      "morgan@<1.12.0": "1.12.0",
      "vitest@<4.1.11": "4.1.11",
      "@vitest/mocker@<4.1.11": "4.1.11",
      "tmp@<0.2.7": "0.2.7",
      "@ai-sdk/provider-utils@>=3.0.0 <3.0.28": "3.0.28",
      "@ai-sdk/provider-utils@>=4.0.0 <4.0.33": "4.0.33",
      "websocket-driver@<0.7.5": "0.7.5",
      "linkify-it@<=5.0.1": "5.0.2",
      "nodemailer@<10.0.6": "10.0.14",
      "find-my-way@<=9.6.0": "9.7.0",
      "next@>=12.0.0 <15.5.27": "15.5.27",
      "sharp@<0.35.5": "0.35.5",
      "fast-uri@>=2.3.1 <=2.4.2": "2.4.3",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.7",
      "fast-uri@<4.2.1": "4.2.1",
      "undici@>=7.0.0 <7.29.1": "7.29.1",
      "@opentelemetry/propagator-jaeger@<2.9.0": "2.9.0",
      "axios@>=1.15.2 <1.20.0": "1.20.0",
      "tar@<=7.5.20": "7.5.22",
      "protobufjs@<=7.6.4": "7.6.5",
      "@opentelemetry/core@<2.8.0": "2.9.0",
      "request@<=2.88.2": "npm:@cypress/request@4.0.1",
      "qs@<6.16.0": "6.16.0",
      "proxy-addr@<2.0.8": "2.0.8",
      "source-map-js@<1.2.2": "1.2.2",
      "fast-copy@<4.1.0": "4.1.0",
      "fastify@<5.12.5": "5.12.5",
      "@fastify/busboy@<3.2.2": "3.2.2",
      "@grpc/grpc-js@<1.14.5": "1.14.5",
      "sanitize-html@<2.17.7": "2.17.7",
      "@xmldom/xmldom@<0.9.12": "0.9.12",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "tough-cookie@<4.1.3": "4.1.3",
      "nanoid@<3.3.18": "3.3.18",
      "body-parser@<1.20.6": "1.20.6",
      "deepmerge-ts@<8.0.0": "8.0.1",
      "browserslist@<=4.28.6": "4.28.8"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^4",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "tsx": "^4",
    "turbo": "^2",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8",
    "vitest": "^4"
  }
}
