# Database
DATABASE_URL=postgresql://quant:quant@localhost:5432/quantdb

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage (Cloudflare R2 or AWS S3 / MinIO)
# Production Cloudflare R2:
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ENDPOINT=https://${CLOUDFLARE_R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT=https://${CLOUDFLARE_R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=quantmail-attachments
# ATTACHMENTS_BUCKET=quantmail-attachments
#
# Production AWS S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=quantmail-attachments
#
# Development S3-compatible (MinIO):
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=quant-uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Email (MailHog for development)
SMTP_HOST=localhost
SMTP_PORT=1025

# Search
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey

# Event Streaming
NATS_URL=nats://localhost:4222

# Auth
JWT_SECRET=development-only-change-in-production
JWT_ISSUER=https://auth.quant-ecosystem.dev

# AI (optional for development; production selects Cloudflare explicitly)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_DEFAULT_MODEL=@cf/meta/llama-3.2-1b-instruct
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-1b-instruct
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts
QUANT_AI_FAIL_CLOSED=true

# Live memory/extraction evals (all optional; tests skip when unset)
# Any OpenAI-compatible /chat/completions gateway works (OpenAI, or the
# Bedrock OpenAI-compatible endpoint). NEVER commit real values.
EXTRACTION_API_KEY=
EXTRACTION_BASE_URL=
EXTRACTION_MODEL=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=
BEDROCK_EMBEDDING_MODEL=
QDRANT_URL=

# ---------------------------------------------------------------------------
# Quanty MCP connectors — Gmail OAuth (Q2 production)
# NEVER commit real values. Provision via the Secret Vault / k8s secrets.
# ---------------------------------------------------------------------------
# Google Cloud OAuth client (https://console.cloud.google.com → APIs & Services
# → Credentials → OAuth client ID). Enable the Gmail API on the project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Backend callback URL — must match the authorized redirect URI registered in
# Google Cloud, e.g. https://quantmail.in/api/quanty/mcp/callback
GOOGLE_OAUTH_REDIRECT=
# HMAC secret signing the OAuth `state` param (32+ random bytes, hex).
GMAIL_OAUTH_STATE_SECRET=
# AES-256-GCM key encrypting stored Gmail refresh tokens (32 bytes: 64 hex
# chars, or a 32-char string). Rotate with re-encryption of mcp_connections.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Where the browser lands after a successful Gmail connect (default: site root).
MCP_CONNECT_SUCCESS_URL=
