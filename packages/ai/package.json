{
  "name": "@quant/ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./unified-ai-service": {
      "types": "./src/services/unified-ai-service.ts",
      "import": "./src/services/unified-ai-service.ts",
      "default": "./src/services/unified-ai-service.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "memory:eval": "vitest run src/__tests__/memory-eval.test.ts --reporter=verbose",
    "routing:eval": "vitest run src/__tests__/routing-eval.test.ts --reporter=verbose",
    "safety:eval": "vitest run src/__tests__/safety-eval.test.ts --reporter=verbose",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/cohere": "^3.0.75",
    "@ai-sdk/deepinfra": "^2.0.94",
    "@ai-sdk/deepseek": "^2.0.79",
    "@ai-sdk/fireworks": "^2.0.100",
    "@ai-sdk/google": "^3.0.141",
    "@ai-sdk/groq": "^3.0.81",
    "@ai-sdk/mistral": "^3.0.79",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/togetherai": "^2.0.96",
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1163.0",
    "@quant/common": "workspace:*",
    "@quant/quant-tools": "workspace:*",
    "ai": "^5.0.285",
    "js-yaml": "^4.2.0",
    "ollama-ai-provider": "^1.2.0",
    "openai": "^4.73.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
